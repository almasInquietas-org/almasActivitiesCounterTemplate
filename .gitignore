# ============================================================
# Secrets & local environment overrides (NEVER commit these)
# ============================================================
.env
.env.local
.env.*.local
*.local
# frontend/.env.development and frontend/.env.production are tracked on purpose:
# they only hold non-secret defaults (API URL, empty key placeholders).
# Real keys go in Vercel / Lambda console / GitHub Secrets.
*.pem
*.key
credentials
.aws/

# ============================================================
# Python (api/, scripts/, tests/)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
.venv/
venv/
env/
.python-version

# Test & coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.mypy_cache/
.ruff_cache/

# ============================================================
# AWS Lambda packaging (Story 8 builds zips in CI)
# ============================================================
*.zip
package/
.aws-sam/

# ============================================================
# Node / Frontend (frontend/)
# ============================================================
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# WireMock local runtime output (mocks/)
# Stub definitions in mocks/wiremock/mappings/ ARE committed.
# ============================================================
mocks/wiremock/__files/recorded-*
mocks/wiremock/requests/

# ============================================================
# Logs
# ============================================================
logs/
*.log

# ============================================================
# Editors & OS
# ============================================================
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.sw?
*.suo
.DS_Store
Thumbs.db
desktop.ini
