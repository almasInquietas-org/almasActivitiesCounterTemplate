# Copy this file to .env.development.local (gitignored) for local development.
# Preview and Production environment variables are configured in Vercel Project Settings.

# Backend API URL (local Flask dev server default)
VITE_API_URL=http://127.0.0.1:5000/

# Public API key identifier (leave blank for local passthrough mode)
VITE_API_KEY=

# Server-only HMAC signing secret (used by Vite dev middleware / Vercel /api/token; never prefix with VITE_)
API_SIGNING_SECRET=
