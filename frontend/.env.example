# Copy this file to .env.development.local (gitignored) for local development.
# Preview and Production environment variables are configured in Vercel Project Settings.
# All variables below are server-only for the /api/dashboard BFF route (never prefix secrets with VITE_).

# Upstream Backend Lambda / Flask API URL (local Flask dev server default)
API_URL=http://127.0.0.1:5000/

# Server-only API key identifier (leave blank for passthrough mode)
API_KEY=

# Server-only HMAC signing secret (leave blank for passthrough mode)
API_SIGNING_SECRET=
