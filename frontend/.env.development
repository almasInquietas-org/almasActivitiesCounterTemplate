# Local development API URL
VITE_API_URL=http://127.0.0.1:5000/

# Public API key identifier (sent via server-side /api/token proxy)
VITE_API_KEY=dev-local-key-12345

# Server-only HMAC signing secret (used by Vite dev server / Vercel /api/token; never exposed to client bundle)
API_SIGNING_SECRET=dev-local-secret-abcdef0123456789
